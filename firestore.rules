rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.uid == "dKjFxtiG8OP3Qh29lqaPPUNsPM23";
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      // User may edit only harmless profile fields; role/titles are owner-controlled.
      allow update: if isOwner() || (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.titles == resource.data.titles);
      allow delete: if isOwner();
    }

    match /purchaseOrders/{id} {
      allow read: if signedIn() && (isOwner() || resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /giveaways/{id} {
      allow read: if true;
      allow create: if isOwner();
      allow update: if signedIn() &&
        (isOwner() ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
          && request.resource.data.participants.size() <= resource.data.maxParticipants
          && request.auth.uid in request.resource.data.participants));
      allow delete: if isOwner();
    }
  }
}
